# Variables de entorno para PRODUCCIÓN
DEBUG=False
SECRET_KEY=your-super-secret-production-key-change-this
ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# Base de datos PostgreSQL
DB_NAME=sustenty_prod
DB_USER=sustenty_prod_user
DB_PASSWORD=super_secure_production_password
#test
# API URLs
REACT_APP_API_URL=https://your-domain.com/api/v1

# Redis
REDIS_PASSWORD=super_secure_redis_password

# Email - Resend (https://resend.com)
# Crear cuenta en https://resend.com y obtener API key
# Plan gratuito: 100 emails/día, 3000/mes
RESEND_API_KEY=re_123456789_your_resend_api_key_here
DEFAULT_FROM_EMAIL=Sustenty <noreply@tu-dominio.com>

# Frontend URL (para links en emails)
FRONTEND_URL=https://your-domain.com

# Google OAuth2 (opcional)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# AWS S3 (opcional para archivos estáticos)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION_NAME=us-west-2